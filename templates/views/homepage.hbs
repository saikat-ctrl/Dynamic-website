{{>header}}
<div class="body-wrapper-inner id="fixx"">
    <div class="container-fluid fixx">
        <div class="card fix">
            <div class="card-body">
                <h5 class="card-title fw-semibold mb-4">Logo</h5>
                <div class="row align-items-center">
                    <!-- Image Preview Box + Reset Button -->
                    <div class="col-md-3 mb-3 position-relative">
                        <div id="image-preview"
                            style="width: 115px; height: 100%; border: 2px dashed #ccc; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative;">
                            <img id="preview-img"
                                src="https://w7.pngwing.com/pngs/819/548/png-transparent-photo-image-landscape-icon-images-thumbnail.png"
                                alt="Preview" style="width: 115px; height: 100%; object-fit: cover;" />
                        </div>
                        <!-- Trash Icon Button -->
                        <button id="reset-btn" type="button"
                            style="position: absolute; top: -10px; right: 120px; background-color: #dc3545; border: none; color: white; display: flex; align-items: center; justify-content: center; font-size: 15px; box-shadow: 0 0 5px rgba(0,0,0,0.3); cursor: pointer;"
                            title="Clear Image">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <!-- Image Upload Form -->
                    <div class="col-md-9 mb-3">
                        <form id="upload-form">
                            <div class="mb-3">
                                <label for="imageInput" class="form-label">Choose an image</label>
                                <input class="form-control" type="file" id="imageInput" accept="image/*">
                            </div>
                        </form>
                    </div>
                </div>



            </div>
        </div>
